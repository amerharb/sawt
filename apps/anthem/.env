# sada — the game-data collector (see packages/game/src/sada.ts).
# Not secrets: these are baked into the public bundle either way.
VITE_SADA_ENABLED=true
VITE_SADA_URL=https://sada.sawt.info

# saha — the multiplayer courtyard (see packages/game/src/saha.ts).
# Also not secrets; both are required before 🏟️ appears at all.
VITE_SAHA_ENABLED=true
VITE_SAHA_URL=https://saha.sawt.info

# baab — sign-in (see packages/game/src/baab.ts).
# Not secrets either. Both are required before 👤 in ⚙️ shows an account at
# all — and it is beta-gated besides, so a production build draws only the
# share link and the feedback there until the gate opens.
VITE_BAAB_ENABLED=true
VITE_BAAB_URL=https://baab.sawt.info
