{
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.sawt.info"
        }
      ],
      "destination": "https://sawt.info/$1",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy/en",
      "permanent": false
    },
    {
      "source": "/privacy/((?!(?:en|ar|de|sv)(?:\\.html)?/?$).*)",
      "destination": "/privacy/en",
      "permanent": false
    }
  ]
}
