# baab — the door: sign-in (see packages/game/src/baab.ts).
# Not secrets: these are baked into the public bundle either way. Both are
# required before Sign in appears at all — and the control is beta-gated
# besides, so a production build draws nothing until the gate opens.
VITE_BAAB_ENABLED=true
VITE_BAAB_URL=https://baab.sawt.info
