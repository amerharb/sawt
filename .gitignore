/.idea
.vscode

# dependencies — one install at the workspace root serves every app
node_modules

# build output
dist
/build

# testing
coverage

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
.vercel

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Each app keeps its own .gitignore for rules only it needs — git honours those
# nested files, so e.g. apps/anthem's non-redistributable MIDI stays excluded.
